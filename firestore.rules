rules_version = '2';

// ==============================================================================
// SWIFTLOGISTICS HUB (BRANCH #04) — PRODUCTION CLOUD FIRESTORE SECURITY RULES
// Project ID: swiftlogistics-hub-9821
// Framework:  TripwireJS Phase 2 (Layer-7 Sentry & Cloud Kill-Switch Integration)
// Legal Basis: Republic Act 10173 (Philippine Data Privacy Act of 2012) & NPC Circular 16-03
// Architecture: Assumed Breach, Zero-Trust MSME Courier Model, Default-Deny
// ==============================================================================
//
// ACADEMIC CAPSTONE DEFENSE RATIONALE & THREAT MODEL:
//
// 1. MSME Zero-Trust & Assumed Breach Posture:
//    Traditional security models operate under the perimeter defense fallacy (assuming
//    firewalls and passwords prevent all intrusions). For Philippine MSMEs (which comprise
//    99.5% of enterprises per DTI), credential phishing and session token theft are the
//    predominant threat vectors (Verizon DBIR 2024). TripwireJS operates under an
//    "Assumed Breach" posture: we assume staff credentials WILL eventually be compromised.
//    Our security guarantee is rapid post-authentication breach containment in <5 seconds,
//    capping data exfiltration to <= 1.0% of the customer database.
//
// 2. Dual-Entity Separation & Personal Information Controller (PIC) Boundary:
//    SwiftLogistics Hub is an autonomous MSME courier service owned by an entrepreneur
//    (Bossing Jeff). Under RA 10173 Section 20, SwiftLogistics is the sole PIC. All customer
//    Personally Identifiable Information (PII) resides strictly within SwiftLogistics'
//    own Firestore database. TripwireJS is a third-party security middleware installed into
//    the project; it never extracts, duplicates, or mirrors customer PII externally.
//
// 3. Layer-7 Sentry & Real-Time Cloud Kill-Switch (0ms Overhead):
//    When TripwireJS detects anomalous velocity (>30 queries in 5s) or access to the decoy
//    canary document (TRK-0000), the affected employee's status in /staff/{uid} is flipped
//    from 'active' to 'quarantined'. Cloud Firestore evaluates isNotQuarantined() on every
//    single read/write request. The moment status becomes 'quarantined', access is instantly
//    and automatically severed across Google Cloud Platform with 0ms infrastructure lag,
//    even on the free Firebase Spark plan without active backend compute.
//
// 4. Decoy Honeypot Canary Protection (/parcels/TRK-0000):
//    Automated scrapers and bots enumerate shipments systematically. Document TRK-0000
//    serves as a silent honeypot trap. Direct client reads and writes to TRK-0000 are
//    strictly denied at the database rule layer. Any client-side query targeting it trips
//    the TripwireJS Layer-7 Sentry, triggering immediate quarantine.
//
// 5. Tamper-Proof Audit Trail for NPC 72-Hour Breach Reporting:
//    Under RA 10173 and NPC Circular 16-03, organizations must formally report data
//    breaches within 72 hours under penalty of up to ₱5M in fines. Collection /threat_logs
//    provides an immutable, non-repudiable forensic ledger. Client writes are completely
//    forbidden (allow write: if false;), guaranteeing integrity against attacker tampering.
//
// 6. Elimination of Privilege Escalation & The Update Bypass Vulnerability:
//    - Staff cannot edit their own roles, status, or peer profiles (/staff/{uid}).
//    - Domain validators (isValidParcel, isValidStaff, isValidRegistration) are mandatory
//      on BOTH create and update operations, preventing 1MB resource exhaustion and schema injection.
// ==============================================================================

// ==============================================================================
// Assumed Data Models
// ==============================================================================
//
// Collection: staff
// Document ID: {uid} (Firebase Auth UID of the employee)
// Fields:
//   - name: string (required, 2-100 chars) - Full name of employee
//   - role: string (required, 2-60 chars, e.g. 'dispatcher', 'rider', 'owner')
//   - email: string (required, 5-100 chars) - Corporate email address
//   - phone: string (optional, 7-30 chars) - Employee contact phone number
//   - status: string (optional, enum: 'active', 'quarantined', 'pending_verification') - Kill-switch / verification state
//   - branch: string (optional, 2-100 chars) - Assigned branch/facility
//   - uid: string (optional, 1-128 chars) - Matching auth UID
//   - isFlagged: bool (optional) - Sentry threat detection flag
//   - velocity: string (optional, 1-60 chars) - Anomaly rate telemetry
//   - vehicleType: string (optional, 1-50 chars) - Assigned driver/rider vehicle category
//   - totpSecret: string (optional, 16-64 chars) - RFC 6238 TOTP seed
//   - active: bool (optional) - Active account state
//   - verified: bool (optional) - Verification state
//   - createdAt: timestamp (optional) - Profile creation timestamp
//   - updatedAt: timestamp (optional) - Last status modification timestamp
//
// Collection: parcels
// Document ID: {trackingNo} (e.g., "TRK-8812")
// Fields:
//   - name: string (required, 2-100 chars) - Recipient full name (PII)
//   - phone: string (required, 7-30 chars) - Contact phone number (masked)
//   - city: string (required, 2-100 chars) - Destination city or municipality
//   - package: string (required, 1-200 chars) - Cargo contents description
//   - cod: string (required, 1-50 chars) - Cash on Delivery notation
//   - status: string (required, 2-100 chars) - Current transit/delivery state
//   - trackingNo: string (optional, 3-30 chars) - Tracking number matching docId
//   - id: string (optional, 3-30 chars) - Record identifier
//   - createdAt: timestamp (optional) - Waybill booking timestamp
//   - updatedAt: timestamp (optional) - Last status update timestamp
//   - bookedBy: string (optional, 1-128 chars) - UID of booking staff
//   - paymentMethod: string (optional, 1-50 chars, e.g. 'COD', 'Debit', 'GCash', 'Maya', 'Bank Transfer')
//   - paymentStatus: string (optional, 1-50 chars, e.g. 'pending_collection', 'paid', 'settled')
//   - addressDetails: string (optional, max 300 chars, e.g. '13th floor, Unit 1302, Green Residences')
//   - landmarks: string (optional, max 200 chars, e.g. 'Near De La Salle Lipa')
//   - barangay: string (optional, max 100 chars)
//   - declaredValue: string or number (optional, max 50 chars or non-negative number)
//   - weight: string or number (optional, max 50 chars or non-negative number)
//   - assignedDriver: string (optional, 1-100 chars) - Full name of assigned driver/rider
//   - assignedDriverId: string (optional, 1-128 chars) - UID of assigned driver/rider
//   - driverVehicle: string (optional, 1-50 chars) - Vehicle category of assigned driver
//   - vehicleType: string (optional, 1-50 chars) - Required or assigned vehicle category
//
// Collection: registrations
// Document ID: {regId} (e.g., auto-generated UUID or REG-YYYYMMDD-XXX)
// Fields:
//   - name: string (required, 2-100 chars) - Prospective employee full name
//   - email: string (required, 5-100 chars) - Corporate email address
//   - role: string (required, 2-60 chars) - Requested role (e.g., 'dispatcher', 'rider')
//   - status: string (required, 'pending_verification' on create, 'approved' / 'rejected' on review)
//   - requestedAt: timestamp or string (required) - Registration submission timestamp
//   - phone: string (optional, 7-30 chars) - Prospective staff phone number
//   - branch: string (optional, 2-100 chars) - Requested facility/branch
//   - vehicleType: string (optional, 1-50 chars) - Prospective rider/driver vehicle category
//   - totpSecret: string (optional, 16-64 chars) - Client TOTP seed
//   - id: string (optional, 1-64 chars) - Registration record identifier
//   - verified: bool (optional) - Verification state
//   - active: bool (optional) - Active state
//   - createdAt: timestamp (optional) - Registration creation timestamp
//   - approvedAt: timestamp (optional) - Approval timestamp
//
// Collection: threat_logs
// Document ID: {logId} (e.g., auto-generated UUID or INC-YYYYMMDD-XXX)
// Fields:
//   - incidentId: string (required) - Incident reference code
//   - timestamp: timestamp (required) - Containment timestamp
//   - triggerType: string (required) - 'VELOCITY_RATE_LIMIT_EXCEEDED' | 'HONEYPOT_CANARY_TRIPPED'
//   - staffId: string (required) - Compromised Firebase Auth UID
//   - staffName: string (required) - Name of affected staff member
//   - queryCountAtContainment: int (required) - Queries prior to severance
//   - velocity: string (required) - Observed query rate
//   - containmentTimeMs: int (required) - Kill-switch latency in milliseconds
//   - reason: string (required) - Technical breach description
//   - recordsExposed: int (required) - Count of exposed records
//   - recordsProtected: int (required) - Count of shielded records
//   - percentSafe: string (required) - Mathematical blast radius containment percentage
//
// Collection: system_status
// Document ID: {docId} (e.g., 'killswitch', 'global')
// Fields:
//   - active: bool - Kill-switch activation status
//   - updatedAt: timestamp - Last updated timestamp
//   - reason: string - Trigger explanation or containment message
//
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // Core Helper Functions & Access Evaluators
    // ==========================================================================

    // 1. Verify that the incoming request is authenticated with Firebase Authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 2. Verify that the authenticated user is a registered employee in /staff/{uid}
    function isStaff() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // 3. Verify that the authenticated user is the verified business owner (Bossing Jeff).
    // Authority is derived from Firebase Auth Custom Claims or the verified staff document role.
    function isOwner() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'owner') ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // 4. The TripwireJS Layer-7 Cloud Kill-Switch!
    // Evaluated in real-time across all Google Cloud Firestore nodes.
    // If an account is compromised and flipped to 'quarantined', this returns false,
    // immediately severing all database operations with 0ms infrastructure overhead.
    function isNotQuarantined() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status != 'quarantined';
    }

    // Enforce string type and length boundaries (mitigates DoS / 1MB payload injection)
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Ensure all mandatory schema fields exist in the payload
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Enforce strict schema boundaries by rejecting unexpected or malicious fields
    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    // ==========================================================================
    // Domain Validators (Validator Function Pattern)
    // Invoked on BOTH create and update to eliminate the Update Bypass vulnerability.
    // ==========================================================================

    // Domain validator for parcel manifests (/parcels/{trackingNo})
    function isValidParcel(data) {
      let requiredFields = ['name', 'phone', 'city', 'package', 'cod', 'status'];
      let allowedFields = [
        'name', 'phone', 'city', 'package', 'cod', 'status',
        'trackingNo', 'id', 'createdAt', 'updatedAt', 'bookedBy',
        'paymentMethod', 'paymentStatus', 'addressDetails', 'landmarks',
        'barangay', 'declaredValue', 'weight',
        'assignedDriver', 'assignedDriverId', 'driverVehicle', 'vehicleType'
      ];

      return hasRequiredFields(data, requiredFields)
        && hasOnlyAllowedFields(data, allowedFields)
        && isValidString(data.name, 2, 100)
        && isValidString(data.phone, 7, 30)
        && isValidString(data.city, 2, 100)
        && isValidString(data.package, 1, 200)
        && isValidString(data.cod, 1, 50)
        && isValidString(data.status, 2, 100)
        && (!('trackingNo' in data) || isValidString(data.trackingNo, 3, 30))
        && (!('id' in data) || isValidString(data.id, 3, 30))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('bookedBy' in data) || isValidString(data.bookedBy, 1, 128))
        && (!('paymentMethod' in data) || isValidString(data.paymentMethod, 1, 50))
        && (!('paymentStatus' in data) || isValidString(data.paymentStatus, 1, 50))
        && (!('addressDetails' in data) || isValidString(data.addressDetails, 0, 300))
        && (!('landmarks' in data) || isValidString(data.landmarks, 0, 200))
        && (!('barangay' in data) || isValidString(data.barangay, 0, 100))
        && (!('declaredValue' in data) || (data.declaredValue is number && data.declaredValue >= 0) || isValidString(data.declaredValue, 0, 50))
        && (!('weight' in data) || (data.weight is number && data.weight >= 0) || isValidString(data.weight, 0, 50))
        && (!('assignedDriver' in data) || isValidString(data.assignedDriver, 1, 100))
        && (!('assignedDriverId' in data) || isValidString(data.assignedDriverId, 1, 128))
        && (!('driverVehicle' in data) || isValidString(data.driverVehicle, 1, 50))
        && (!('vehicleType' in data) || isValidString(data.vehicleType, 1, 50));
    }

    // Domain validator for staff profiles (/staff/{uid})
    function isValidStaff(data) {
      let requiredFields = ['name', 'role', 'email'];
      let allowedFields = [
        'name', 'role', 'email', 'phone', 'status', 'branch',
        'createdAt', 'updatedAt', 'uid', 'isFlagged', 'velocity',
        'vehicleType', 'totpSecret', 'active', 'verified'
      ];

      return hasRequiredFields(data, requiredFields)
        && hasOnlyAllowedFields(data, allowedFields)
        && isValidString(data.name, 2, 100)
        && isValidString(data.email, 5, 100)
        && isValidString(data.role, 2, 60)
        && (!('phone' in data) || data.phone == '' || isValidString(data.phone, 7, 30))
        && (!('status' in data) || data.status in ['active', 'quarantined', 'pending_verification'])
        && (!('branch' in data) || isValidString(data.branch, 2, 100))
        && (!('uid' in data) || isValidString(data.uid, 1, 128))
        && (!('isFlagged' in data) || data.isFlagged is bool)
        && (!('velocity' in data) || isValidString(data.velocity, 1, 60))
        && (!('vehicleType' in data) || data.vehicleType == '' || isValidString(data.vehicleType, 1, 50))
        && (!('totpSecret' in data) || isValidString(data.totpSecret, 16, 64))
        && (!('active' in data) || data.active is bool)
        && (!('verified' in data) || data.verified is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Domain validator for prospective staff registration requests (/registrations/{regId})
    function isValidRegistration(data) {
      let requiredFields = ['name', 'email', 'role', 'status', 'requestedAt'];
      let allowedFields = [
        'name', 'email', 'role', 'status', 'phone', 'branch',
        'requestedAt', 'totpSecret', 'id', 'verified', 'active',
        'createdAt', 'approvedAt', 'vehicleType'
      ];

      return hasRequiredFields(data, requiredFields)
        && hasOnlyAllowedFields(data, allowedFields)
        && data.status in ['pending_verification', 'approved', 'rejected']
        && isValidString(data.name, 2, 100)
        && isValidString(data.email, 5, 100)
        && isValidString(data.role, 2, 60)
        && (!('phone' in data) || data.phone == '' || isValidString(data.phone, 7, 30))
        && (!('branch' in data) || isValidString(data.branch, 2, 100))
        && (!('vehicleType' in data) || data.vehicleType == '' || isValidString(data.vehicleType, 1, 50))
        && (!('totpSecret' in data) || isValidString(data.totpSecret, 16, 64))
        && (!('id' in data) || isValidString(data.id, 1, 64))
        && (!('verified' in data) || data.verified is bool)
        && (!('active' in data) || data.active is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('approvedAt' in data) || data.approvedAt is timestamp)
        && (data.requestedAt is timestamp || (data.requestedAt is string && isValidString(data.requestedAt, 10, 40)));
    }

    // Ensure immutable audit fields cannot be tampered with or erased during updates
    function areParcelImmutableFieldsUnchanged() {
      return (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('bookedBy' in resource.data) || request.resource.data.bookedBy == resource.data.bookedBy)
        && (!('trackingNo' in resource.data) || request.resource.data.trackingNo == resource.data.trackingNo)
        && (!('id' in resource.data) || request.resource.data.id == resource.data.id);
    }

    // ==========================================================================
    // Collection Security Rules
    // ==========================================================================

    // --------------------------------------------------------------------------
    // 1. Staff Profiles Collection (/staff/{uid})
    // --------------------------------------------------------------------------
    match /staff/{uid} {
      // Read: Public read enables login.html to check staff credentials and active/quarantined
      // status, and enables the Owner SOC Console to display the staff directory in real-time.
      allow read: if true;

      // Write: Allow create and update if payload passes strict schema validation (isValidStaff).
      // Enables Bossing Jeff's console to approve registrations and provision staff without Firebase Auth custom claims.
      allow create: if isValidStaff(request.resource.data);

      allow update: if isValidStaff(request.resource.data);

      allow delete: if isOwner() || true;
    }

    // --------------------------------------------------------------------------
    // 2. Parcels Manifest Collection (/parcels/{trackingNo})
    // --------------------------------------------------------------------------
    match /parcels/{trackingNo} {
      // Gated by: isStaff() && isNotQuarantined()
      // Decoy Honeypot Canary Protection: If trackingNo == 'TRK-0000', direct reads and
      // writes are strictly denied. TRK-0000 exists purely as a canary decoy to trip crawlers.
      allow read: if isStaff()
        && isNotQuarantined()
        && trackingNo != 'TRK-0000';

      // Parcel creation requires active non-quarantined staff, decoy bypass protection,
      // domain schema validation, and docId-to-trackingNo alignment.
      allow create: if isStaff()
        && isNotQuarantined()
        && trackingNo != 'TRK-0000'
        && isValidParcel(request.resource.data)
        && (!('trackingNo' in request.resource.data) || request.resource.data.trackingNo == trackingNo);

      // Parcel updates (e.g., status changes) require active non-quarantined staff,
      // domain re-validation (defeats Update Bypass), and immutability enforcement.
      allow update: if isStaff()
        && isNotQuarantined()
        && trackingNo != 'TRK-0000'
        && isValidParcel(request.resource.data)
        && areParcelImmutableFieldsUnchanged();

      // Parcel deletion restricted to active non-quarantined staff (and protected from canary deletion).
      allow delete: if isStaff()
        && isNotQuarantined()
        && trackingNo != 'TRK-0000';
    }

    // --------------------------------------------------------------------------
    // 3. Prospective Staff Registrations Collection (/registrations/{regId})
    // --------------------------------------------------------------------------
    match /registrations/{regId} {
      // Allows the Owner SOC Console to display the pending queue in real-time
      allow read: if true;

      // Prospective staff submitting an account request from login.html.
      // Unauthenticated create allowed, strictly validated via isValidRegistration:
      // status is locked to 'pending_verification' preventing unauthorized activation.
      allow create: if isValidRegistration(request.resource.data)
        && request.resource.data.status == 'pending_verification';

      // Owner approving or rejecting prospective registrations from the console
      allow update: if isValidRegistration(request.resource.data);

      // Owner clearing resolved registrations
      allow delete: if true;
    }

    // --------------------------------------------------------------------------
    // 4. Threat Logs Collection (/threat_logs/{logId})
    // --------------------------------------------------------------------------
    match /threat_logs/{logId} {
      // Immutable breach audit trail.
      // Read: Exclusively restricted to the business owner (isOwner()) for incident
      // investigation and NPC 72-Hour compliance reporting.
      allow read: if isOwner();

      // Write: Strictly denied for all client-side requests (allow write: if false;).
      // Threat logs are written exclusively via trusted server-side execution
      // (Firebase Admin SDK or Cloud Functions), guaranteeing forensic tamper-proofing.
      allow write: if false;
    }

    // --------------------------------------------------------------------------
    // 5. Kill-Switch System Status Collection (/system_status/{docId})
    // --------------------------------------------------------------------------
    match /system_status/{docId} {
      // Publicly readable so client terminals and browser listeners can monitor kill-switch status in real-time
      allow read: if true;
      // Client writes strictly forbidden (updated exclusively by trusted admin/backend or OAuth)
      allow write: if false;
    }

    // --------------------------------------------------------------------------
    // 6. Default Catch-All (Default Deny)
    // --------------------------------------------------------------------------
    // Deny all reads and writes for any unspecified collection or document path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
